################################################################################
# Frontend Environment Variables (.env)
# These are used by Vite and are embedded into your frontend bundle.
# ⚠️ WARNING: All VITE_ prefixed variables are PUBLIC and visible in browser!
################################################################################

# Supabase Configuration (Required)
# Get these from: Supabase Dashboard > Your Project > Settings > API
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="your_supabase_anon_key_here"

# SECURITY NOTE:
# - VITE_SUPABASE_ANON_KEY is DESIGNED to be public
# - It's protected by Row Level Security (RLS) in your database
# - Users can only access their own data through RLS policies
# - This is the standard secure Supabase architecture

################################################################################
# Edge Function Secrets (NOT in .env file!)
# These must be configured via Supabase CLI for server-side security:
# 
#   supabase secrets set GEMINI_API_KEY=your_key_here
#
# ⚠️ NEVER put API keys (Gemini, OpenAI, etc.) in this .env file!
# ⚠️ They would be exposed in your frontend bundle!
#
# Auto-injected by Supabase (no manual setup needed):
#   - SUPABASE_URL
#   - SUPABASE_SERVICE_ROLE_KEY (bypasses RLS - server-only!)
#   - SUPABASE_ANON_KEY
#
# See supabase/functions/README.md for detailed setup
################################################################################
